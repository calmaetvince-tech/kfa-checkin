# Public — safe in browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public base URL of the app (used in QR-encoded URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — rate limiting for the public /m/[token] page.
# If both are set, the member page is limited to 10 requests/min/IP.
# If unset, rate limiting is a no-op (fine for local dev). Get these from
# https://console.upstash.com (create a free Redis database).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
